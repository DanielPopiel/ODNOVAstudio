    { "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; mokabud_demo_setup();" },
    { "step": "setSiteOptions", "options": { "blogname": "Mokabud", "permalink_structure": "/%postname%/" } }
  ]
